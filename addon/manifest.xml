<?xml version="1.0" encoding="UTF-8"?>
<!-- Input: DSH 桥加载项清单 -->
<!-- Output: WPS 加载项注册元数据 -->
<manifest xmlns="http://schemas.wps.cn/oaassist/2019/manifest"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <id>wps-claude-addon</id>
    <version>1.2.0</version>
    <name>DSH 桥</name>
    <description>一键启停 wps-exec 服务、显示手机连接命令、修改端口与探活。</description>
    <author>DSH</author>

    <hosts>
        <host name="wps"/>
        <host name="et"/>
        <host name="wpp"/>
    </hosts>

    <permissions>
        <permission name="document.read"/>
        <permission name="system.shell"/>
        <permission name="external.program"/>
        <permission name="process.launch"/>
    </permissions>

    <ribbon src="ribbon.xml"/>

    <scripts>
        <script src="js/main.js"/>
    </scripts>

</manifest>
